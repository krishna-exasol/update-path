# cmd_logs [target] [-f|--follow] [--lines N] [--path] — every log the kit can
# show, in one place. No target lists what is available; a target tails it.
cmd_logs() {
    _log_target=""
    _log_follow=0
    _log_lines=200
    _log_path_only=0
    _log_json=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -f|--follow) _log_follow=1 ;;
            --path)      _log_path_only=1 ;;
            --json|-j)   _log_json=1 ;;
            --lines)     shift; _log_lines="${1:-200}" ;;
            -n)          shift; _log_lines="${1:-200}" ;;
            -*)          reject "Unknown option '$1' for logs (supported: -f/--follow, --lines N, --path, --json)." ;;
            *)           [ -n "$_log_target" ] && reject "Only one log target at a time (got '$_log_target' and '$1')."
                         _log_target="$1" ;;
        esac
        shift
    done
    case "$_log_lines" in
        ''|*[!0-9]*) reject "--lines needs a number (got '$_log_lines')." ;;
    esac
    if [ -z "$_log_target" ]; then
        if [ "$_log_json" -eq 1 ]; then
            exakit_logs_overview_json || die "python3 is needed for --json."
            return 0
        fi
        exakit_logs_overview
        return 0
    fi
    [ "$_log_json" -eq 1 ] && \
        reject "--json lists the log targets; it does not apply to one target's contents. Use: exakit logs --json, then exakit logs $_log_target --path"
    exakit_logs_show "$_log_target" "$_log_follow" "$_log_lines" "$_log_path_only"
}

cmd_data_load() {
    _require_install
    case "${1:-}" in
        ""|--force) ;;
        *) reject "Unknown option '$1' for data-load (only --force is supported)." ;;
    esac
    command -v exakit_load_sample_data >/dev/null 2>&1 || \
        die "The exapump data-loading module is not available in this kit build."
    exakit_init_logging
    # Loading data needs a database that answers — a stopped one used to make
    # the dataset checks silently trust the manifest and the load itself fail.
    exakit_ensure_runtime_running deploy
    if [ "${1:-}" = "--force" ]; then
        _kit_root="$(exakit_repo_root)" || \
            die "Could not find the kit's sql/ and data/ files to load."
        # EXAKIT_DATASETS names WHICH datasets; --force says "reload them even
        # though they are already there". They compose. --force used to ignore
        # the variable outright and reload the bundled sample alone, so an
        # unattended `EXAKIT_DATASETS=tpch,energy,weather exakit data-load
        # --force` silently restored one of the three and reported success —
        # with no way at all to reload the others without a full re-install.
        if [ -n "${EXAKIT_DATASETS:-}" ]; then
            _dl_known=" $(exakit_bundled_datasets | cut -d'|' -f1 | tr '\n' ' ') "
            _dl_any=0
            _dl_failed=0
            for _dl_id in $(printf '%s' "$EXAKIT_DATASETS" | tr ',' ' '); do
                case "$_dl_known" in
                    *" $_dl_id "*)
                        _dl_any=1
                        info "Reloading dataset '$_dl_id' (EXAKIT_DATASETS, --force)"
                        exakit_load_dataset "$_kit_root" "$_dl_id" "--force" || _dl_failed=1
                        ;;
                    *)
                        warn "Unknown dataset id '$_dl_id' in EXAKIT_DATASETS (available:$(printf '%s' "$_dl_known" | sed 's/ *$//'))."
                        ;;
                esac
            done
            [ "$_dl_any" -eq 1 ] || \
                die "EXAKIT_DATASETS='$EXAKIT_DATASETS' matched no bundled dataset — nothing was reloaded."
            return "$_dl_failed"
        fi
        info "Reloading the bundled sample dataset (log: ${EXAKIT_LOG_FILE:-none})"
        exakit_load_sample_data "$_kit_root" "--force"
    else
        command -v exakit_data_load_menu >/dev/null 2>&1 || \
            die "The exapump data-loading module is not available in this kit build."
        exakit_data_load_menu
    fi
}

