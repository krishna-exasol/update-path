# cmd_mcp_doctor [--json] [clients] — diagnostics, with the DIAGNOSIS ORDER a
# diagnostician uses: is the database even running, before anything that needs
# it? Without that check the first downstream failure (creating the read-only
# user against a dead port) used to headline as "MCP user is broken" and send
# people at the MCP config — the wrong subsystem entirely. Exit 3 mirrors
# `exakit status`, so agents branch the same way on both.
#
# Doctor also REPAIRS what it finds. There is no separate repair command: being
# told a client is broken and then handed a second command to type is the tool
# asking the user to do the obvious next step by hand.
cmd_mcp_doctor() {
    # Parse BEFORE the install check: the check's own answer has to honour
    # --json, and it has to exit 4 rather than 1. Reversing these two lines is
    # what made `mcp-doctor --json` print nothing on a machine with no install.
    _cmd_json=0
    _cmd_rest=""
    for _cmd_arg in "$@"; do
        case "$_cmd_arg" in
            --json|-j) _cmd_json=1 ;;
            *) _cmd_rest="${_cmd_rest:+$_cmd_rest }$_cmd_arg" ;;
        esac
    done
    if [ ! -f "$EXAKIT_MANIFEST" ] || [ -z "$(_runtime_type)" ]; then
        _not_installed_answer "$_cmd_json"
    fi
    exakit_init_logging
    if ! exakit_runtime_is_running; then
        if [ "$_cmd_json" -eq 1 ]; then
            # Same three keys as every other --json answer from a state query
            # (installed / status / remedy), so one parser handles all of them.
            # `database` is kept for callers written against the older shape.
            printf '{"installed": true, "status": "database not running", "database": "not running", "remedy": "%s"}\n' \
                "$(exakit_runtime_remedy)"
        else
            warn "The database is not running — fix that first: $(exakit_runtime_remedy)"
            info "MCP diagnostics need a live database (the read-only user and its grants are checked against it)."
        fi
        exit 3
    fi
    if [ "$_cmd_json" -eq 1 ]; then
        EXAKIT_MCP_RESULT_JSON=1
        export EXAKIT_MCP_RESULT_JSON
    fi
    # shellcheck disable=SC2086 — client names are single tokens by contract
    exakit_mcp_operation doctor $_cmd_rest
    _cmd_rc=$?
    [ "$_cmd_rc" = 0 ] && return 0
    # Anything other than "ran and reported" is the subsystem failing to run at
    # all, which is the only case that deserves the word "could not".
    [ "$_cmd_rc" = 2 ] || die "Could not run MCP diagnostics"

    # The diagnosis found something. Repair it here rather than printing a
    # second command to type: someone runs mcp-doctor to be told their clients
    # are fine, and being handed `exakit mcp-repair` is the tool asking the user
    # to do the obvious next step by hand. mcp-setup ADDS clients; mcp-doctor
    # checks the ones already configured and puts them right.
    #
    # --json callers get the diagnosis unchanged: a machine parsing the report
    # must not have a second document appended to it.
    if [ "$_cmd_json" -eq 1 ]; then
        exit 1
    fi
    # The repair runs QUIETLY. Its own summary panel repeats the client list and
    # the operation header the diagnosis above just printed, and in the common
    # case it has nothing to say beyond "no repair was needed" - three
    # near-identical reports for one question, where the reader is trying to
    # work out what actually happened. One line is the whole content.
    printf '\n'
    # shellcheck disable=SC2086 — client names are single tokens by contract
    _cmd_repair_out="$(exakit_mcp_operation repair $_cmd_rest 2>&1)"
    _cmd_repair_rc=$?
    if [ "$_cmd_repair_rc" != 0 ] && [ "$_cmd_repair_rc" != 2 ]; then
        printf '%s\n' "$_cmd_repair_out"
        die "Could not repair the managed MCP configuration"
    fi

    case "$_cmd_repair_out" in
        *no_change*|*"already consistent"*)
            # Nothing was rewritten, so a re-check would reprint the report
            # above word for word. Say what happened and stop.
            info "Nothing to repair: the managed client config is already consistent."
            warn "The findings above are not config drift, so they remain."
            exit 1
            ;;
    esac

    # Something WAS rewritten, so the report above is now out of date. Re-check
    # once - once only: a repair that did not take is a fault to report, not a
    # loop to run - and let that reading be the last word.
    info "Repaired the managed client config — re-checking"
    printf '\n'
    # shellcheck disable=SC2086 — client names are single tokens by contract
    exakit_mcp_operation doctor $_cmd_rest
    _cmd_rc=$?
    [ "$_cmd_rc" = 0 ] && { ok "Everything the repair could fix is fixed."; return 0; }
    [ "$_cmd_rc" = 2 ] || die "Could not run MCP diagnostics"
    warn "Some findings are not config drift and remain — see the notes above."
    exit 1
}

