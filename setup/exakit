    # comment block (from line 2) up to the first non-comment line — no
    # hardcoded range, so new command lines always appear instead of being
    # silently truncated. Plain `exakit help` (and a bare `exakit`) prints
    # only the short everyday list below, so a first-time user sees a handful
    # of commands, not the whole surface. Mirrors PowerShell Show-ExakitUsage.
    if [ "${1:-}" = "--all" ] || [ "${1:-}" = "-a" ]; then
        awk 'NR > 1 { if ($0 !~ /^#/) exit; sub(/^# ?/, ""); print }' "$0"
        return
    fi
    cat <<'EOF'
exakit — Exasol Personal Local Starter Kit

Get started:
  exakit mcp-setup     connect your AI assistant (Claude, Cursor, Codex)

Everyday commands:
  status               is the database up and healthy?
  info                 show your connection details
  start | stop         run or pause the database and add-on services
  autostart [on|off]   come back automatically after a restart
  data-load            load the sample data or your own CSV / Parquet / JSON
  mcp-doctor           check MCP config of AI clients you connected, and repair
  marketplace          optional add-ons (dashboards & more)

Keeping up to date:
  version              installed version details
  update-check         what would change, and what it involves
  update               apply the latest updates
EOF
}

# cmd_info_json — the install record, verbatim, on stdout.
#
# manifest.json is what every other command reads: which runtime, which versions,
# which paths, what the last data load did. `exakit info --json` hands that to a
# script or a support thread without anyone having to know where the file lives.
#
# Printed byte for byte rather than re-serialised: this is a copy of the file, and
# a reformatting step could only make it disagree with the file. The writer already
# emits two-space-indented JSON with a trailing newline (manifest_set).
#
# Nothing else may reach stdout on this path — no banner, no update notice, no
# hint — or the output stops being JSON. The dispatcher keeps it out of
# `_with_notice` for exactly that reason, and the failure below goes to stderr.
#
# Secrets are not a concern here: the manifest stores password *file paths*
# (runtime.password_file, components.mcp_server.connection.password_file), never a
# password. Keep it that way.
cmd_info_json() {
    [ -s "$EXAKIT_MANIFEST" ] || _not_installed_answer 1
    cat "$EXAKIT_MANIFEST"
    # THE SAME TRI-STATE AS `status`. AGENTS.md documents 0/3/4 for this command
    # and it only ever answered 0 or 4, so an agent that branched on the exit code
    # the way it was told read "healthy" off a stopped database. The record on
    # stdout is unchanged and complete either way; only the code was lying.
    exakit_runtime_is_running || exit 3
    exit 0
}

# cmd_sql <statement> [--write] — run one SQL statement and translate the error.
#
# WHY THIS EXISTS: the kit has an error translator that turns the three raw
# engine faults every agent hits first into a remedy ("use LIMIT", "exakit
# start", "describe it first"), and it was wired ONLY into the kit's own internal
# setup SQL — the one path no agent ever sees. Running SQL the documented way
# (`exapump sql -p starter-kit`) produced the raw engine text with a generic
# hint, so "every error message names its remedy" was true of the lifecycle
# commands and false of the SQL path the skill tells the agent to use for every
# validation. This is that path, with the translator attached.
#
# NOT A SANDBOX, and the help says so. The `starter-kit` profile is the ADMIN
# connection; the statement gate below is a seatbelt against a typo, not a
# security boundary. The boundary is the MCP read-only user, which the database
# itself enforces. --write is how you say you meant it.
cmd_sql() {
    _require_install
    _sql_write=0
    _sql_text=""
    for _sql_arg in "$@"; do
        case "$_sql_arg" in
            --write) _sql_write=1 ;;
            --*) reject "Unknown option '$_sql_arg' for sql (supported: --write)." ;;
            *) [ -n "$_sql_text" ] && reject "Pass ONE statement, quoted: exakit sql 'SELECT 1'" ; _sql_text="$_sql_arg" ;;
        esac
    done
    [ -n "$_sql_text" ] || reject "Nothing to run. Usage: exakit sql 'SELECT ...' [--write]"

    if [ "$_sql_write" -ne 1 ]; then
        # Normalise for the check only; the statement runs exactly as given.
        _sql_probe="$(printf '%s' "$_sql_text" | tr '\n\t' '  ' | sed 's/^ *//')"
        _sql_head="$(printf '%s' "$_sql_probe" | cut -c1-8 | tr '[:lower:]' '[:upper:]')"
        case "$_sql_head" in
            SELECT*|WITH*|DESCRIBE*|EXPLAIN*|SHOW*) : ;;
            *) reject "That is not a read statement, and 'exakit sql' defaults to reads. Re-run with --write if you mean it — and note the profile it uses is the ADMIN connection, not the read-only MCP user." ;;
        esac
        # Reject a second statement outright. The MCP tool gate lets
        # "SELECT 1; DROP TABLE T" through because it only inspects the opening
        # keyword — the engine happens to refuse it, but nothing above the engine
        # does. Refusing it here costs nothing and removes the same footgun.
        case "$(printf '%s' "$_sql_probe" | sed 's/;* *$//')" in
            *";"*) reject "Only one statement at a time. A trailing ';' is fine; a second statement is not." ;;
        esac
    fi

    _sql_out="$("$(exapump_cli)" sql -p "$EXAKIT_EXAPUMP_PROFILE" "$_sql_text" 2>&1)"
    _sql_rc=$?
    printf '%s\n' "$_sql_out"
    if [ "$_sql_rc" -ne 0 ]; then
        # The whole point: say what to do about it.
        exakit_explain_db_error "$_sql_out"
    fi
    return "$_sql_rc"
}

# cmd_whats_new [version] — what changed, for this kit or a named one.
#
# Defaults to the version actually installed rather than the newest section in the
# file: a user on 0.2.0 asking what is new wants their own release notes, not a
# preview of one they do not have yet.
