#!/usr/bin/env bash
# exakit — lifecycle helper for the Exasol Personal Local Starter Kit.
#
# usage: exakit <command>
#
#   preflight           check this machine's requirements, install nothing
#   status              show what is installed and whether it is healthy
#   version             kit source, install date, and every component's
#                       installed version beside the advertised one
#   update [what] [--yes]
#                       apply the advertised versions without deleting database data.
#                       A runtime change stops the database, so on a terminal it is
#                       offered ("stop the database and update it now?") and applied
#                       on yes; without a terminal it is deferred unless --yes (or
#                       EXAKIT_CONFIRM_RUNTIME_UPDATE=1) says otherwise
#                       Personal major upgrades support --plan, --backup, --apply
#   info [--json]       print the connection details panel; --json prints the
#                       install record (manifest.json) verbatim, nothing else
#   guide               friendly walkthrough: connect AI clients (MCP), SQL
#                       clients (DBeaver, DbVisualizer), and Python (pyexasol)
#   start               start the local database and every add-on service
#   stop                stop them again
#   repair-runtime [--yes]  rebuild a database that cannot be started (the
#                       launcher reports it interrupted and every start fails);
#                       DESTRUCTIVE — the deployment is replaced and its data
#                       is gone, bundled datasets are reloaded afterwards
#   autostart           whether everything comes back after a restart; shows
#                       the current state and asks whether to change it
#   data-load [--force|<path>]
#                       open focused data loading options; a file path loads that
#                       file, a FOLDER path bulk-loads every CSV/Parquet/JSON file
#                       in it (one table each); --force reloads bundled datasets
#   sql '<statement>' [--write]
#                       run one SQL statement and translate the error into a
#                       remedy; reads only unless --write. Uses the ADMIN
#                       connection (the read-only boundary is the MCP user)
#   mcp-setup           permanently configure MCP in supported AI clients
#   mcp-doctor          check the configured MCP clients, repair what has
#                       drifted, then re-check (there is no separate repair)
#   mcp-status          show managed MCP state for the supported AI clients
#   skills [--json]     list the kit's AI skills and whether each one has
#                       reached the agents' discovery folders
#   skills-install      install the kit's AI skills for CLI agents
#                       (~/.claude/skills, ~/.agents/skills)
#   marketplace         browse optional add-ons (dash-server, ...) and install
#                       the ones you select; installed add-ons then update
#                       through `exakit update` like every other component
#   upgrade-kit2        add the Kit 2 trust assets (Trusted AI Workflow add-on)
#                       on top of this install; nothing is reinstalled
#   rollback-kit2       remove exactly what upgrade-kit2 added; the database and
#                       every Kit 1 component stay untouched
#   uninstall [--yes] [--dry-run]
#                       pick what to remove — components, add-ons, or
#                       EVERYTHING (database + data, MCP client configs,
#                       skills, exapump, pyexasol, the kit home and the CLI
#                       binaries) — with a summary and a typed confirmation.
#                       --dry-run previews the full plan; --yes is the
#                       scripted full uninstall
#   whats-new [version] what changed in this kit version
#   logs [target] [--json]
#                       every log the kit can show; no target lists them.
#                       --json lists the targets and their paths machine-readably
#                       (-f follows, --lines N, --path prints the path)
#   catalog [search] [--json]
#                       browse/search every exakit, exapump & exasol command;
#                       --json prints the whole command surface as an object
#   help                this text
#
# Installed to ~/.local/bin by the setup scripts; also runs straight from a
# repo checkout (setup/exakit).

set -u
set -o pipefail

# --- locate the kit's lib directory ----------------------------------------
_script_dir="$(cd "$(dirname "$0")" && pwd)"
if [ -f "$_script_dir/lib/common.sh" ]; then
    _lib_dir="$_script_dir/lib"
elif [ -f "${EXAKIT_HOME:-$HOME/.exasol-starter-kit}/kit/setup/lib/common.sh" ]; then
    _lib_dir="${EXAKIT_HOME:-$HOME/.exasol-starter-kit}/kit/setup/lib"
else
    # Name the path actually searched, not the default. With EXAKIT_HOME set this
    # message used to send the reader to ~/.exasol-starter-kit/kit while the code
    # had looked somewhere else entirely.
    echo "exakit: cannot find the kit library (looked in $_script_dir/lib and ${EXAKIT_HOME:-$HOME/.exasol-starter-kit}/kit/setup/lib)" >&2
    echo "exakit: if EXAKIT_HOME is set, it must point at an install that has kit/setup/lib; otherwise re-run the installer." >&2
    exit 1
fi

. "$_lib_dir/common.sh"
. "$_lib_dir/detect.sh"
. "$_lib_dir/runtime-nano.sh"
. "$_lib_dir/runtime-personal.sh"
[ -f "$_lib_dir/help.sh" ] && . "$_lib_dir/help.sh"
[ -f "$_lib_dir/exapump.sh" ] && . "$_lib_dir/exapump.sh"
[ -f "$_lib_dir/mcp.sh" ] && . "$_lib_dir/mcp.sh"
# pyexasol is an update target of its own (and its own repair command), so the
# CLI needs the module even though it takes no part in the runtime commands.
[ -f "$_lib_dir/pyexasol.sh" ] && . "$_lib_dir/pyexasol.sh"
# Marketplace add-on modules: the CLI is where they are installed (exakit
# marketplace) and updated (exakit update <addon>), so it loads every module
# it ships. A missing file only makes the marketplace row unavailable.
[ -f "$_lib_dir/dash-server.sh" ] && . "$_lib_dir/dash-server.sh"
[ -f "$_lib_dir/exasol-vscode.sh" ] && . "$_lib_dir/exasol-vscode.sh"
[ -f "$_lib_dir/json-tables.sh" ] && . "$_lib_dir/json-tables.sh"
[ -f "$_lib_dir/exasol-scheduler.sh" ] && . "$_lib_dir/exasol-scheduler.sh"

_runtime_type() {
    manifest_get runtime.type 2>/dev/null
}

_require_install() {
    # Logging FIRST. Every caller used to run this check and only then call
    # exakit_init_logging, so a failure here wrote .last-failure and produced
    # no log at all — leaving `exakit logs`, the diagnostic AGENTS.md points at,
    # with nothing to show for the failure that just happened.
    exakit_init_logging 2>/dev/null || true
    [ -f "$EXAKIT_MANIFEST" ] || die "No installation found. Run the installer first."
    [ -n "$(_runtime_type)" ] || die "No runtime recorded in the manifest yet."
}

# _not_installed_answer <json:0|1> — the not-installed answer for a STATE QUERY.
#
# A bare `die` here fails an agent twice over: it exits 1 where the documented
# contract says 4, and it leaves stdout empty, so a caller piping --json into a
# parser gets "Expecting value: line 1 column 1" on precisely the path where
# structured signal matters most. `status --json` always answered with an
# object; the other state queries did not, and the three disagreed.
_not_installed_answer() {
    if [ "${1:-0}" -eq 1 ]; then
        # `installed`, `status` and `remedy` appear in EVERY --json answer these
        # state queries can give (see the db-not-running answer in
        # cmd_mcp_doctor). They used to differ per state with no key in common,
        # so a parser that read .status off the healthy shape hit a KeyError on
        # exactly the two states worth branching on.
        printf '{"installed": false, "status": "not installed", "manifest": "%s", "reason": "no install record", "remedy": "run the installer"}\n' \
            "$EXAKIT_MANIFEST"
    else
        printf 'Not installed (no manifest at %s). Run the installer first.\n' "$EXAKIT_MANIFEST" >&2
    fi
    exit 4
}

# cmd_status [--json] — what is installed and whether it is up.
#
# THE EXIT CODE IS PART OF THE ANSWER. An unattended agent branches on $?, not
# on prose, so this command distinguishes its states the way `git diff --quiet`
# or `systemctl is-active` do:
#     0  installed and the database is running
#     3  installed but the database is NOT running (start it: exakit start)
#     4  not installed at all
# `--json` prints one machine-readable object built from the same fields the
# prose shows (same exit codes; nothing else on stdout). Loaded datasets are
# included in both forms: the manifest records them, and reconstructing state
# after a context reset must not require knowing where that file lives.
# _cs_engine_suffix — " (docker)" when a container runtime is what runs the
# database, empty when the runtime is native. Reads the manifest only.
_cs_engine_suffix() {
    _cse="$(manifest_get runtime.engine 2>/dev/null || true)"
    [ -n "$_cse" ] && printf ' (%s)' "$_cse"
}

# _cs_mcp_clients — "<label>|<state>" per AI client, from the manifest alone.
#
# configured_clients is what mcp-setup actually wrote; every other known client
# is reported as not installed. No probing and no config parsing: this is the
# state the kit recorded, and `exakit mcp-doctor` is the command that re-checks
# it against the machine.
_cs_mcp_clients() {
    manifest_get components.mcp_server.client_setup.configured_clients >/dev/null 2>&1 || return 0
    require_python3 2>/dev/null || return 0
    run_python - "$EXAKIT_MANIFEST" <<'EXAKIT_CS_MCP'
import json, sys

LABELS = [
    ("claude_desktop", "Claude"),
    ("claude_code", "Claude Code (CLI)"),
    ("cursor", "Cursor"),
    ("codex", "Codex"),
    ("vscode_copilot", "GitHub Copilot"),
    ("gemini_cli", "Gemini CLI"),
    ("opencode", "OpenCode"),
    ("continue", "Continue"),
]
try:
    with open(sys.argv[1], encoding="utf-8") as handle:
        doc = json.load(handle)
except (OSError, ValueError):
    raise SystemExit(0)
setup = (
    doc.get("components", {}).get("mcp_server", {}).get("client_setup", {}) or {}
)
configured = set(setup.get("configured_clients") or [])
skipped = set(setup.get("skipped_clients") or [])
for key, label in LABELS:
    if key in configured:
        state = "configured"
    elif key in skipped:
        state = "skipped"
    else:
        state = "not installed"
    print("%s|%s" % (label, state))
EXAKIT_CS_MCP
}

cmd_status() {
    _cs_json=0
    for _cs_arg in "$@"; do
        case "$_cs_arg" in
            --json|-j) _cs_json=1 ;;
            *) reject "Unknown option '$_cs_arg' for status (supported: --json)." ;;
        esac
    done
    # One helper for all three state queries, so status/info/mcp-doctor cannot
    # drift apart again on the shape or the exit code of this answer.
    [ -f "$EXAKIT_MANIFEST" ] || _not_installed_answer "$_cs_json"
    _type="$(_runtime_type)"
    # Each phase names what it is waiting on. Only drawn on a terminal, and
    # never for --json: ui_spin_begin re-checks that at call time, and the
    # command substitutions below capture their own stdout regardless.
    if [ "$_cs_json" -eq 0 ]; then ui_spin_begin "Checking the database"; fi
    case "$_type" in
        nano)     _cs_db="$(nano_status)" ;;
        personal) _cs_db="$(personal_status)" ;;
        *)        _cs_db="unknown" ;;
    esac
    if [ "$_cs_json" -eq 0 ]; then ui_spin_end; fi
    _cs_running=0
    case "$_cs_db" in running*) _cs_running=1 ;; esac
    _cs_autostart="$(manifest_get autostart.enabled 2>/dev/null || true)"
    if [ "$_cs_json" -eq 0 ]; then ui_spin_begin "Checking which datasets are loaded"; fi
    _cs_datasets="$(exakit_loaded_datasets 2>/dev/null | tr '\n' ' ' | sed 's/ $//')"
    if [ "$_cs_json" -eq 0 ]; then ui_spin_end; fi
    _cs_pyx="$(exakit_component_current pyexasol 2>/dev/null || true)"
    # An install in progress is its own state. The step name is in the manifest
    # (begin_step writes it) and the lock names the installer's pid; both have
    # to agree, so a crashed install never reads as "installing" forever.
    _cs_installing=0
    _cs_step="$(manifest_get install.current_step 2>/dev/null || true)"
    if [ -n "$_cs_step" ] && [ -f "$EXAKIT_HOME/.install.lock" ]; then
        _cs_lock_pid="$(cat "$EXAKIT_HOME/.install.lock" 2>/dev/null || true)"
        if [ -n "$_cs_lock_pid" ] && kill -0 "$_cs_lock_pid" 2>/dev/null; then _cs_installing=1; fi
    fi

    if [ "$_cs_json" -eq 1 ]; then
        # Composed in Python so every value is escaped properly; the service
        # map is passed pre-joined because the registry drives it.
        _cs_services=""
        for _st_id in $(exakit_service_ids 2>/dev/null); do
            [ "$_st_id" = "database" ] && continue
            _cs_services="${_cs_services}${_st_id}=$(exakit_service_status "$_st_id")
"
        done
        # The last recorded failure, if one is still pending. The human screen
        # already prints "pyexasol: not installed — repair: exakit update
        # pyexasol"; the JSON carried only `"pyexasol": null`, so the agent's
        # own channel was the one missing the actionable half.
        _cs_note=""
        _cs_note_at=""
        if [ -f "$EXAKIT_HOME/.last-failure" ]; then
            _cs_note="$(sed -n '1p' "$EXAKIT_HOME/.last-failure" 2>/dev/null || true)"
            # Line 2 is the timestamp. Reporting a reason without a date invites
            # an agent to act on a note whose cause was fixed long ago.
            _cs_note_at="$(sed -n '2p' "$EXAKIT_HOME/.last-failure" 2>/dev/null || true)"
        fi
        run_python - "$(manifest_get kit_level 2>/dev/null)" "${_type:-}" "$_cs_db"             "${_cs_autostart:-false}" "$_cs_datasets" "${_cs_pyx:-}" "$EXAKIT_MANIFEST"             "$(manifest_get steps_completed 2>/dev/null)" "$_cs_services" "$_cs_note" "$_cs_note_at" \
            "$_cs_installing" "$_cs_step" <<'EXAKIT_SJ_PY'
import json, sys
kit, rtype, db, autostart, datasets, pyx, manifest, steps, services, note, note_at, installing, step = sys.argv[1:14]
installing = installing == "1"
try:
    steps_list = json.loads(steps) if steps else []
except ValueError:
    steps_list = []
smap = {}
for line in services.splitlines():
    if "=" in line:
        key, value = line.split("=", 1)
        smap[key] = value
running = db.startswith("running")
# Remedies are additive: an agent should never have to infer the fix from a
# null, and should never have to parse the human screen to find one.
remedies = {}
if not pyx:
    remedies["pyexasol"] = "exakit update"
if not running:
    # "exakit start" is the wrong remedy for an INTERRUPTED deployment: it fails
    # identically every time, which is how an agent ends up looping on it. The
    # runtime reports that state distinctly so the remedy can differ.
    remedies["database"] = (
        "exakit repair-runtime" if db.startswith("interrupted") else "exakit start"
    )
if db.startswith("conflict"):
    # Something else is on the SQL port. `exakit start` cannot help until it is gone.
    remedies["database"] = "another process is listening on the database port — stop it, then: exakit start"
if installing:
    remedies["install"] = "the installer is still running (step: %s) — poll exakit status --json until status is running" % (step or "unknown")
# A step the installer never finished. With the installer gone (no live lock)
# the manifest's steps_completed is the only trace, and `remedies` was empty
# for it: a session that picked the machine up after a crashed install saw
# "running" and nothing else. The map is documented as "component -> the exact
# repair command", so each unfinished step names one. Order is the installer's.
STEP_REMEDIES = [
    ("launcher", "re-run the installer (it resumes at the unfinished step)"),
    ("runtime", "re-run the installer (it resumes at the unfinished step)"),
    ("exapump", "re-run the installer (it resumes at the unfinished step)"),
    ("mcp", "exakit mcp-setup"),
    ("pyexasol", "exakit update"),
    ("exakit_helper", "re-run the installer (it resumes at the unfinished step)"),
]
steps_missing = []
if not installing:
    for step_id, fix in STEP_REMEDIES:
        if step_id not in steps_list:
            steps_missing.append(step_id)
            remedies.setdefault(step_id, fix)
payload = {
    "installed": True,
    # Top-level `status` and `remedy` are the keys EVERY --json answer from a
    # state query carries, in every state (see _not_installed_answer and the
    # db-not-running answer in cmd_mcp_doctor). runtime.status stays exactly
    # where it was; this is the one field a parser can read without first
    # knowing which of the three shapes it received.
    "status": "installing" if installing else db,
    "installing": installing,
    "install_step": (step or None) if installing else None,
    "kit_level": kit or None,
    "runtime": {"type": rtype or None, "status": db},
    "running": running,
    "services": smap,
    "autostart": autostart == "true",
    "datasets_loaded": datasets.split() if datasets else [],
    "steps_completed": steps_list,
    "steps_missing": steps_missing,
    "pyexasol": pyx or None,
    "remedies": remedies,
    # The single most useful remedy, hoisted so it sits at the same key in every
    # state a state query can report. `remedies` keeps the full per-component map.
    # An unfinished step ranks below a stopped database (start it first) and
    # above nothing: a running machine with a step missing is not "remedy: null".
    "remedy": remedies.get("install") or remedies.get("database")
        or (remedies.get(steps_missing[0]) if steps_missing else None),
    "last_failure": note or None,
    "last_failure_at": note_at or None,
    "manifest": manifest,
}
print(json.dumps(payload, indent=2))
EXAKIT_SJ_PY
        # 0 means healthy AND complete: while the installer runs, a poller that
        # reads the exit code must not see success off a half-built kit.
        [ "$_cs_installing" -eq 1 ] && exit 3
        [ "$_cs_running" -eq 1 ] && exit 0 || exit 3
    fi

    # One label column for the whole screen. The pad was a hardcoded 11, but
    # "dash-server:" is 12, so every service row sat a column out of line — and
    # the registry can add longer ids than that. Measure instead of guessing.
    _cs_lw=12
    for _st_id in $(exakit_service_ids 2>/dev/null); do
        [ "$_st_id" = "database" ] && continue
        _cs_n=$(( ${#_st_id} + 1 ))
        [ "$_cs_n" -gt "$_cs_lw" ] && _cs_lw=$_cs_n
    done
    _cs_row() { printf "%-${_cs_lw}s %s\n" "$1" "$2"; }

    # FOUR PANELS, NOT ONE LIST OF LABELS.
    #
    # status answers "what is true right now". It used to answer that for the
    # runtime and nothing else: which add-ons are installed, which AI clients
    # are actually wired to the database, and how much data is in it were all
    # invisible, even though the manifest records every one of them.
    #
    # NOTHING HERE QUERIES THE DATABASE. Every value below is read from the
    # manifest or from the service probes status already ran. That is
    # deliberate: process launches are what made this screen slow, so the
    # landscape got wider without getting slower.
    #
    # Versions are NOT here and paths are NOT here - `exakit version` owns the
    # first and `exakit info` owns the second. Repeating them was the thing
    # that made the older screens feel like the same content three times.
    # 17 fits the widest label this screen prints, "Claude Code (CLI)".
    # It was 15, and that one row pushed its value out of the column.
    _cs_pad() { printf '%-17s %s' "$1" "$2"; }

    ui_panel_begin "Kit"
    ui_panel_line "$(_cs_pad 'Runtime' "${_type:-none}$(_cs_engine_suffix) · $_cs_db")"
    ui_panel_line "$(_cs_pad 'Database' "$(manifest_get runtime.dsn 2>/dev/null || printf 'unknown')$(
        if [ "$_cs_running" -eq 1 ]; then printf ' · reachable'
        elif [ "$_cs_db" = "conflict" ]; then printf ' · port held by another process (not Exasol) — stop it, then: exakit start'
        else printf ' · not reachable'; fi)")"
    if [ "$_cs_installing" -eq 1 ]; then
        ui_panel_line "$(_cs_pad 'Install' "in progress · step: $_cs_step — poll: exakit status")"
    fi
    # "enabled"/"disabled", not "on"/"off": this row reports a STATE, and on/off
    # reads as the switch you flip rather than the position it is in. The
    # The command itself takes no verb: it shows this state and asks.
    if [ "$_cs_autostart" = "true" ]; then
        ui_panel_line "$(_cs_pad 'Autostart' 'enabled')"
    else
        ui_panel_line "$(_cs_pad 'Autostart' 'disabled — change it with: exakit autostart')"
    fi
    # "Kit level" is an internal schema number. It means nothing to the person
    # reading this screen, and `exakit version` carries what they do want.
    # NOT the install date: `exakit version` already prints it, and repeating
    # it here is exactly the duplication that made the older screens read like
    # the same content three times.
    ui_panel_end
    printf '\n'

    # --- add-ons ------------------------------------------------------------
    # Registry-driven on both halves: a new add-on appears here on its own, and
    # the ones you do NOT have are named too, because "what could I add" is
    # half of "what is my kit".
    ui_panel_begin "Add-ons"
    # exakit_marketplace_addons yields "id|label" LINES. Splitting on whitespace
    # turned every label into separate words and the id into "dash-server|dash-server",
    # which matched no add-on - so a kit with three of them installed reported
    # none. Read line by line and cut the id.
    _cs_installed=""
    _cs_absent=""
    while IFS='|' read -r _cs_aid _cs_alabel; do
        [ -n "$_cs_aid" ] || continue
        if exakit_marketplace_addon_installed "$_cs_aid" 2>/dev/null; then
            _cs_astate="installed"
            # A service add-on reports the state it is really in; the rest are
            # simply present. Registry-driven, so a new one appears on its own.
            for _st_id in $(exakit_service_ids 2>/dev/null); do
                [ "$_st_id" = "$_cs_aid" ] || continue
                _cs_astate="$(exakit_service_status "$_st_id")"
                _cs_aport="$(manifest_get "components.$(printf '%s' "$_cs_aid" | tr '-' '_').port" 2>/dev/null || true)"
                [ -n "$_cs_aport" ] && _cs_astate="$_cs_astate · http://127.0.0.1:$_cs_aport"
            done
            _cs_installed="${_cs_installed}${_cs_installed:+
}$_cs_aid|$_cs_astate"
        else
            _cs_absent="${_cs_absent:+$_cs_absent, }$_cs_aid"
        fi
    done <<EXAKIT_CS_ADDONS
$(exakit_marketplace_addons 2>/dev/null)
EXAKIT_CS_ADDONS
    if [ -n "$_cs_installed" ]; then
        while IFS='|' read -r _cs_aid _cs_astate; do
            [ -n "$_cs_aid" ] || continue
            ui_panel_line "$(_cs_pad "$_cs_aid" "$_cs_astate")"
        done <<EXAKIT_CS_INSTALLED
$_cs_installed
EXAKIT_CS_INSTALLED
    else
        ui_panel_line "$(_cs_pad 'none' 'add one with: exakit marketplace')"
    fi
    # What you could add is half of "what is my kit".
    [ -n "$_cs_absent" ] && ui_panel_line "$(_cs_pad 'available' "$_cs_absent")"
    ui_panel_end
    printf '\n'

    # --- AI clients ---------------------------------------------------------
    # The whole point of the kit is an AI client that can query the database,
    # and status never said whether one was connected.
    ui_panel_begin "AI clients (MCP)"
    _cs_clients="$(_cs_mcp_clients)"
    if [ -n "$_cs_clients" ]; then
        # HEREDOC, NOT A PIPE. `... | while read` runs the loop in a SUBSHELL,
        # and ui_panel_line only appends to a variable - so every line would be
        # written into a shell that exits a moment later and the panel would
        # render EMPTY. Fed from a heredoc the loop runs in this shell and the
        # buffer survives.
        # Only the clients that ARE connected. Eight rows of which five said
        # "not installed" answered a question nobody asked of a status screen --
        # what this machine does not have -- and buried the three that matter.
        # `exakit mcp-setup` is where the full roster belongs, because there the
        # list IS the choice.
        _cs_any=0
        while IFS='|' read -r _cs_cl _cs_cs; do
            [ -n "$_cs_cl" ] || continue
            [ "$_cs_cs" = "configured" ] || continue
            ui_panel_line "$(_cs_pad "$_cs_cl" "$_cs_cs")"
            _cs_any=1
        done <<EXAKIT_CS_CLIENTS
$_cs_clients
EXAKIT_CS_CLIENTS
        # A record of configured clients that yields no configured ROW means
        # every one of them was skipped: say so rather than draw an empty panel.
        [ "$_cs_any" -eq 1 ] || \
            ui_panel_line "$(_cs_pad 'none' 'connect one with: exakit mcp-setup')"
    else
        ui_panel_line "$(_cs_pad 'none' 'connect one with: exakit mcp-setup')"
    fi
    ui_panel_end
    printf '\n'

    # --- data ---------------------------------------------------------------
    ui_panel_begin "Data"
    if [ -n "$_cs_datasets" ]; then
        for _cs_ds in $_cs_datasets; do
            _cs_dsch="$(manifest_get "data.datasets.${_cs_ds}.schema" 2>/dev/null || printf '%s' "$(printf '%s' "$_cs_ds" | tr '[:lower:]' '[:upper:]')")"
            _cs_dt="$(manifest_get "data.datasets.${_cs_ds}.tables" 2>/dev/null || true)"
            _cs_dr="$(manifest_get "data.datasets.${_cs_ds}.rows" 2>/dev/null || true)"
            _cs_dline="loaded"
            if [ -n "$_cs_dt" ]; then
                _cs_dline="$_cs_dt table$([ "$_cs_dt" = "1" ] || printf 's')"
                [ -n "$_cs_dr" ] && _cs_dline="$_cs_dline, $(exakit_group_digits "$_cs_dr") rows"
            fi
            ui_panel_line "$(printf '%-11s %-11s %s' "$_cs_ds" "$_cs_dsch" "$_cs_dline")"
        done
        # No "last load" row: the rows above already say what is in the
        # database, which is the question. Which of them arrived most recently
        # is not something anyone acts on.
    else
        ui_panel_line 'none loaded — load some with: exakit data-load'
    fi
    ui_panel_end
    printf '\n'

    # Every SOFT component, not just one. exapump, the MCP server and pyexasol
    # all install through exakit_soft_step, so ANY of them can be missing from an
    # install that finished. The install-time report (exakit_print_soft_failures)
    # prints once and is gone by the time anyone types `exakit status`.
    #
    # This screen used to give pyexasol a dedicated "not installed" line and say
    # nothing about the other two: a failed exapump showed up only as an absence
    # from the steps_completed array, which is precisely the kind of signal a
    # reader does not notice. Same failure, three different treatments.
    #
    # steps_completed itself is gone from the human screen: it was raw JSON in a
    # screen a person reads, and it reported trouble only by omission. This says
    # it directly. `status --json` still carries steps_completed untouched.
    _cs_missing=""
    while IFS='|' read -r _cs_cid _cs_ckey _cs_cfix; do
        [ -n "$_cs_cid" ] || continue
        # A manifest record is what says "this install attempted the component",
        # so a kit copy built without one of them is not reported as broken.
        manifest_get "$_cs_ckey" >/dev/null 2>&1 || continue
        exakit_component_current "$_cs_cid" >/dev/null 2>&1 && continue
        _cs_missing="${_cs_missing}${_cs_missing:+
}$(printf '%-9s repair: %s' "$_cs_cid" "$_cs_cfix")"
    done <<EXAKIT_CS_SOFT
exapump|components.exapump.validated|exakit update
mcp|components.mcp_server.validated|exakit update
pyexasol|components.pyexasol.validated|exakit update
EXAKIT_CS_SOFT
    if [ -n "$_cs_missing" ]; then
        _cs_label='Missing:'
        _cs_oifs=$IFS; IFS='
'
        for _cs_line in $_cs_missing; do
            IFS=$_cs_oifs
            _cs_row "$_cs_label" "$_cs_line"
            _cs_label=''
            _cs_oifs=$IFS; IFS='
'
        done
        IFS=$_cs_oifs
    fi
    # No "Manifest:" row: an internal file path, on the last line of the screen,
    # that nothing on this screen asks the reader to open.
    # Superseded launchers the kit set aside during an upgrade. Each is a full
    # ~130 MB binary, and nothing reported them, so they accumulated silently
    # and no command would ever reclaim the space.
    _cs_strays="$(exakit_stray_launchers 2>/dev/null || true)"
    if [ -n "$_cs_strays" ]; then
        _cs_row 'Stray:' "$(printf '%s superseded launcher(s) in %s — safe to delete: %s' \
            "$(printf '%s\n' "$_cs_strays" | wc -l | tr -d ' ')" \
            "$EXAKIT_BIN_DIR" "rm $(printf '%s ' $_cs_strays)")"
    fi
    if [ "$_cs_running" -ne 1 ]; then
        # An interrupted deployment cannot be started, so pointing at `exakit
        # start` here is worse than useless: it is the loop the reader was
        # already in. Name the command that actually clears it.
        case "$_cs_db" in
            interrupted*) _cs_row 'Repair it:' 'exakit repair-runtime   (replaces the database; its data is not recoverable)' ;;
            conflict*)    _cs_row 'Free the port:' 'another process is listening on the database port — stop it, then: exakit start' ;;
            *)            _cs_row 'Start it:' 'exakit start' ;;
        esac
        exit 3
    fi
    # 0 means healthy AND complete: while the installer runs, a poller that reads
    # the exit code must not see success off a half-built kit.
    [ "$_cs_installing" -eq 1 ] && exit 3
    exit 0
}

cmd_start() {
    _require_install
    # Logging FIRST: run_logged only routes the launcher's raw JSON stream to
    # the logfile when one exists — without this, `exakit start` interleaved
    # multi-line launcher logs with its own [ok] lines on stdout.
    exakit_init_logging 2>/dev/null || true
    # Everything the kit runs, database first: self-heal semantics for the
    # runtime (a stopped one is started, a missing one deployed — `exakit
    # start` promises a running database), then every add-on service.
    case "$(_runtime_type)" in
        nano)     [ "$(nano_status 2>/dev/null)" = "running" ] && ok "Database is already running" || exakit_ensure_runtime_running deploy ;;
        personal)
            if personal_deployment_running 2>/dev/null; then
                ok "Database is already running"
            elif [ "$(personal_status 2>/dev/null)" = "conflict" ]; then
                # Port open is not database up: with another program on 8563 this
                # said "already running" and exited 0 while status said stopped.
                die "Port $EXAKIT_PERSONAL_PORT is held by another process$(personal_port_holder_hint), not by Exasol, so the database cannot start. Stop that process, then: exakit start"
            else
                exakit_ensure_runtime_running deploy
            fi
            ;;
        *)        exakit_ensure_runtime_running deploy ;;
    esac
    for _start_id in $(exakit_service_ids); do
        [ "$_start_id" = "database" ] && continue
        exakit_service_start "$_start_id" || true
    done
    # The database is up, so a note left by an earlier start that could not
    # ("Port 8563 is held by another process ...") is no longer true. Only a
    # runtime note goes; an install-step note is a different fault and stays.
    exakit_runtime_is_running 2>/dev/null && exakit_clear_runtime_failure_note
    return 0
}

cmd_stop() {
    _require_install
    exakit_init_logging 2>/dev/null || true
    # Add-on services first: they talk to the database, so they should be down
    # before it goes.
    for _stop_id in $(exakit_service_ids); do
        [ "$_stop_id" = "database" ] && continue
        exakit_service_stop "$_stop_id" || true
    done
    case "$(_runtime_type)" in
        nano)     nano_stop ;;
        personal) personal_stop ;;
    esac
}

# cmd_repair_runtime [--yes] — rebuild a database that cannot be started.
#
# THE ESCAPE FROM A WEDGE, and the reason it exists: a SIGKILLed Exasol Personal
# runner leaves the launcher's workflow state "interrupted", after which every
# start fails identically forever. Before this command the documented recovery
# was a loop — the installer skipped the deployment step as already done, failed
# at start, and closed by advising a re-run that behaved the same way, while
# EXAKIT_REUSE_DB=0 never got a say because the skip happened first.
#
# Re-running the platform setup script IS the repair: the deployment step already
# knows how to try a start, watch it fail, destroy and deploy fresh. Dropping the
# `runtime` tick first is what lets it be reached, and it also covers a runtime
# whose wedge this kit does not yet recognise. Everything downstream (the MCP
# read-only user, the datasets) is rebuilt by the same run, because a replaced
# database has none of them.
#
# DESTRUCTIVE: the deployment is replaced and its data is gone. Interactive runs
# are asked; --yes and EXAKIT_CONFIRM_RUNTIME_REPAIR=1 pre-answer it.
cmd_repair_runtime() {
    _require_install
    _rr_yes=0
    for _rr_arg in "$@"; do
        case "$_rr_arg" in
            --yes|-y) _rr_yes=1 ;;
            *) reject "Unknown option '$_rr_arg' for repair-runtime (supported: --yes)." ;;
        esac
    done
    [ "${EXAKIT_CONFIRM_RUNTIME_REPAIR:-0}" = "1" ] && _rr_yes=1

    _rr_kit="$(exakit_repo_root)" || die "Could not find the kit copy to re-run setup from. Re-run the installer instead."
    case "$(detect_os)" in
        macos)      _rr_setup="setup/setup-macos.sh" ;;
        linux|wsl)  _rr_setup="setup/setup-wsl.sh" ;;
        *)          die "repair-runtime has no setup script for this platform. On Windows, re-run install.ps1." ;;
    esac
    [ -f "$_rr_kit/$_rr_setup" ] || die "The kit copy at $_rr_kit has no $_rr_setup. Re-run the installer instead."

    warn "Repairing the runtime REPLACES the database. Its data is not recoverable."
    info "Bundled datasets are reloaded afterwards; anything you loaded yourself is not."
    if [ "$_rr_yes" -ne 1 ]; then
        if ! confirm "Delete the database and rebuild it now?" n; then
            # DECLINING A DESTRUCTIVE PROMPT IS THE SAFE ANSWER, not an error.
            # die() rendered it as a red error card and exited 1 - and because
            # die() calls exakit_note_failure, it also left `exakit status
            # --json` reporting a last_failure on a machine where nothing had
            # gone wrong. common.sh documents that exact hazard as the reason
            # reject() exists; the answer here is simpler still, because "no,
            # not now" is a successful outcome of this command.
            info "Repair cancelled — nothing was changed."
            info "When you are ready: exakit repair-runtime --yes (or set EXAKIT_CONFIRM_RUNTIME_REPAIR=1)"
            return 0
        fi
    fi

    exakit_init_logging
    # Drop the tick so the deployment step runs even on a runtime whose wedged
    # state step_artifact_state cannot yet recognise.
    exakit_unmark_step runtime
    info "Re-running $_rr_setup to rebuild the database"
    export EXAKIT_BANNER_SHOWN=1
    # The deployment step must NOT offer to reuse what is there. Its reuse
    # question defaults to YES, so a repair that the user had just confirmed as
    # destructive ("its data is not recoverable") answered itself with "keep the
    # existing database" and reported "Reusing the existing Exasol deployment".
    # The command did not repair anything, and the second question contradicted
    # the first one it had just been given.
    #
    # EXAKIT_REUSE_DB=0 is the documented way to force a fresh deployment, and
    # it is what this command has meant all along.
    export EXAKIT_REUSE_DB=0
    exec bash "$_rr_kit/$_rr_setup"
}

# cmd_autostart — one command: show where it stands, then offer to flip it.
#
# It was three (`on`, `off`, and a bare form that only reported), which made the
# reader pick the verb before being told what the current state even was -- and
# the bare form then closed by explaining the other two. Now the answer comes
# first and the only decision left is yes or no.
#
# EXAKIT_AUTOSTART_CHANGE pre-answers it for automation, the same contract every
# other prompt in the kit uses; without a terminal the default is NO CHANGE, so
# a scripted run can never silently flip a boot setting.
cmd_autostart() {
    _require_install
    exakit_init_logging 2>/dev/null || true
    [ "$#" -eq 0 ] || \
        reject "autostart takes no arguments — run 'exakit autostart' and answer the question."

    exakit_autostart_print

    _as_total=0
    _as_on=0
    for _as_id in $(exakit_service_ids); do
        _as_total=$(( _as_total + 1 ))
        if _exakit_autostart_registered "$_as_id"; then _as_on=$(( _as_on + 1 )); fi
    done
    [ "$_as_total" -gt 0 ] || return 0

    # "Everything is on" is the only state that offers to turn things off;
    # anything else -- none of it, or some of it -- offers to turn it all on,
    # because a partly-registered set is the one a reader wants made whole.
    if [ "$_as_on" -eq "$_as_total" ]; then
        confirm_env EXAKIT_AUTOSTART_CHANGE "Turn it off?" n || return 0
        exakit_autostart_disable
    else
        confirm_env EXAKIT_AUTOSTART_CHANGE "Turn it on?" n || return 0
        exakit_autostart_enable
    fi
}

cmd_uninstall() {
    # Distinct variable names (_uni_*): exakit_uninstall_run assigns globals like
    # _dry without `local`, so a plain _dry here would be clobbered by the
    # plan-display call below.
    _uni_yes=0
    _uni_dry=0
    for _uni_arg in "$@"; do
        case "$_uni_arg" in
            -y|--yes)      _uni_yes=1 ;;
            -n|--dry-run)  _uni_dry=1 ;;
            *) reject "Unknown option '$_uni_arg' for uninstall (supported: --yes, --dry-run)." ;;
        esac
    done
    exakit_init_logging 2>/dev/null || true

    # Nothing installed anywhere we can see? Say so and stop.
    if [ ! -f "$EXAKIT_MANIFEST" ] && [ ! -e "$EXAKIT_BIN_DIR/exasol" ] && \
       [ ! -e "$EXAKIT_BIN_DIR/exakit" ] && [ ! -d "$EXAKIT_HOME" ]; then
        info "Nothing to uninstall — no manifest, kit home, or installed binaries were found."
        exit 0
    fi

    # --dry-run previews the FULL plan; --yes is the scripted full uninstall
    # (automation and AGENTS.md rely on both). Everything else goes through
    # the selectable menu: pick what goes, see what that means, type the word.
    if [ "$_uni_dry" = 1 ]; then
        printf '\n'
        warn "exakit uninstall PERMANENTLY removes the Exasol Personal Local Starter Kit."
        info "A full uninstall (the EVERYTHING row, or --yes) removes:"
        exakit_uninstall_run 1
        printf '\n'
        info "Not touched: uv/uvx (shared tool), any PATH line in your shell profile, and anything the kit did not install."
        info "Dry run only — nothing was removed. Pick individual pieces interactively with: exakit uninstall"
        exit 0
    fi

    if [ "$_uni_yes" = 1 ]; then
        printf '\n'
        warn "exakit uninstall --yes removes the FULL kit (all local database data included)."
        exakit_uninstall_run 0
        printf '\n'
        ok "Uninstall complete — the Exasol Personal Local Starter Kit has been removed."
        info "If a PATH entry for $EXAKIT_BIN_DIR remains in your shell profile (~/.zshrc, ~/.bashrc, ~/.profile), remove it manually if you no longer need it."
        exit 0
    fi

    exakit_uninstall_menu
}

# cmd_version — one screen for "what have I got, and is any of it out of date?"
#
# This used to be two commands. `exakit version` listed what was installed and
# `exakit update-check` compared it against the advertised set, so answering the
# only question either was ever asked meant running both and reading one screen
# against the other. The Kit panel below is the part with no
# component/version/status shape; everything else is the table in
# exakit_print_version_table.
# ⇄ twin: Invoke-CmdVersion in setup/exakit.ps1.
cmd_version() {
    _cv_json=0
    for _cv_arg in "$@"; do
        case "$_cv_arg" in
            --json|-j) _cv_json=1 ;;
            *) reject "Unknown option '$_cv_arg' for version (supported: --json)." ;;
        esac
    done
    # Exit 4, not 0: an agent using `version` as a cheap liveness probe read a
    # success code off a machine with nothing installed.
    [ -f "$EXAKIT_MANIFEST" ] || { [ "$_cv_json" -eq 1 ] && _not_installed_answer 1; echo "Not installed (no manifest at $EXAKIT_MANIFEST)"; exit 4; }
    if [ "$_cv_json" -eq 1 ]; then
        exakit_can_run_python || die "python3 is needed for --json."
        exakit_print_version_table --json
        exit $?
    fi
    ui_panel_begin "Kit"
    ui_panel_line "$(printf '%-14s %s' Version "$(exakit_component_current exakit 2>/dev/null || printf 'unknown')")"
    # No "Level" row: an internal schema number, meaningless to the reader.
    # No "Source" row either: an absolute path to the kit's own copy of itself,
    # which answers a question nobody asks of a version screen.
    ui_panel_line "$(printf '%-14s %s' Installed "$(exakit_format_local_time "$(manifest_get installed_at 2>/dev/null)")")"
    ui_panel_end
    printf '\n'
    exakit_print_version_table
}

cmd_update() {
    _require_install
    exakit_update "$@"
}

# cmd_kit2_script <script> — run one of the kit's own upgrade scripts from the
# installed kit copy, so nobody has to know or type its path.
cmd_kit2_script() {
    _k2_root="$(exakit_repo_root)" || die "Could not locate the kit's upgrade/ scripts."
    _k2_script="$_k2_root/upgrade/$1"
    [ -f "$_k2_script" ] || die "$1 is not part of this kit build."
    bash "$_k2_script"
}

# cmd_logs [target] [-f|--follow] [--lines N] [--path] — every log the kit can
# show, in one place. No target lists what is available; a target tails it.
cmd_logs() {
    _log_target=""
    _log_follow=0
    _log_lines=200
    _log_path_only=0
    _log_json=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -f|--follow) _log_follow=1 ;;
            --path)      _log_path_only=1 ;;
            --json|-j)   _log_json=1 ;;
            --lines)     shift; _log_lines="${1:-200}" ;;
            -n)          shift; _log_lines="${1:-200}" ;;
            -*)          reject "Unknown option '$1' for logs (supported: -f/--follow, --lines N, --path, --json)." ;;
            *)           [ -n "$_log_target" ] && reject "Only one log target at a time (got '$_log_target' and '$1')."
                         _log_target="$1" ;;
        esac
        shift
    done
    case "$_log_lines" in
        ''|*[!0-9]*) reject "--lines needs a number (got '$_log_lines')." ;;
    esac
    if [ -z "$_log_target" ]; then
        if [ "$_log_json" -eq 1 ]; then
            exakit_logs_overview_json || die "python3 is needed for --json."
            return 0
        fi
        exakit_logs_overview
        return 0
    fi
    [ "$_log_json" -eq 1 ] && \
        reject "--json lists the log targets; it does not apply to one target's contents. Use: exakit logs --json, then exakit logs $_log_target --path"
    exakit_logs_show "$_log_target" "$_log_follow" "$_log_lines" "$_log_path_only"
}

cmd_data_load() {
    _require_install
    # data-load takes either --force or a PATH. A path names what to load
    # without walking the menu to type it in -- and a folder path is the bulk
    # load: every CSV/Parquet/JSON file in it, one table each.
    _dl_force=""
    _dl_path=""
    case "${1:-}" in
        "")      ;;
        --force) _dl_force="--force" ;;
        -*)      reject "Unknown option '$1' for data-load (pass --force, or a file or folder path)." ;;
        *)       _dl_path="$1" ;;
    esac
    command -v exakit_load_sample_data >/dev/null 2>&1 || \
        die "The exapump data-loading module is not available in this kit build."
    if [ -n "$_dl_path" ]; then
        _dl_norm="$(exakit_normalize_path "$_dl_path")"
        [ -e "$_dl_norm" ] || die "No such file or folder: $_dl_path"
        # Naming a path IS choosing the local-file row, which is exactly what
        # EXAKIT_DATA_FILE already means -- so one contract covers the argument
        # and the variable, and the menu never draws for either.
        EXAKIT_DATA_FILE="$_dl_norm"
        export EXAKIT_DATA_FILE
    fi
    exakit_init_logging
    # Loading data needs a database that answers — a stopped one used to make
    # the dataset checks silently trust the manifest and the load itself fail.
    exakit_ensure_runtime_running deploy
    if [ -n "$_dl_force" ]; then
        _kit_root="$(exakit_repo_root)" || \
            die "Could not find the kit's sql/ and data/ files to load."
        # EXAKIT_DATASETS names WHICH datasets; --force says "reload them even
        # though they are already there". They compose. --force used to ignore
        # the variable outright and reload the bundled sample alone, so an
        # unattended `EXAKIT_DATASETS=tpch,energy,weather exakit data-load
        # --force` silently restored one of the three and reported success —
        # with no way at all to reload the others without a full re-install.
        if [ -n "${EXAKIT_DATASETS:-}" ]; then
            _dl_known=" $(exakit_bundled_datasets | cut -d'|' -f1 | tr '\n' ' ') "
            _dl_any=0
            _dl_failed=0
            for _dl_id in $(printf '%s' "$EXAKIT_DATASETS" | tr ',' ' '); do
                case "$_dl_known" in
                    *" $_dl_id "*)
                        _dl_any=1
                        info "Reloading dataset '$_dl_id' (EXAKIT_DATASETS, --force)"
                        exakit_load_dataset "$_kit_root" "$_dl_id" "--force" || _dl_failed=1
                        ;;
                    *)
                        warn "Unknown dataset id '$_dl_id' in EXAKIT_DATASETS (available:$(printf '%s' "$_dl_known" | sed 's/ *$//'))."
                        ;;
                esac
            done
            [ "$_dl_any" -eq 1 ] || \
                die "EXAKIT_DATASETS='$EXAKIT_DATASETS' matched no bundled dataset — nothing was reloaded."
            return "$_dl_failed"
        fi
        info "Reloading the bundled sample dataset (log: ${EXAKIT_LOG_FILE:-none})"
        exakit_load_sample_data "$_kit_root" "--force"
    elif [ -n "${EXAKIT_DATASETS:-}" ] && [ -z "${EXAKIT_DATA_FILE:-}" ]; then
        # Named datasets, unattended: load the ones not yet loaded, say so for
        # the rest, exit 0. This used to fall through to the interactive menu,
        # whose non-interactive default row is the local file — so "load
        # weather" on a machine that already had it ended in "please enter a
        # file" and exit 1.
        _kit_root="$(exakit_repo_root)" || \
            die "Could not find the kit's sql/ and data/ files to load."
        _dl_known=" $(exakit_bundled_datasets | cut -d'|' -f1 | tr '\n' ' ') "
        _dl_pending=" $(exakit_pending_datasets 2>/dev/null | cut -d'|' -f1 | tr '\n' ' ') "
        _dl_any=0
        _dl_failed=0
        for _dl_id in $(printf '%s' "$EXAKIT_DATASETS" | tr ',' ' '); do
            case "$_dl_known" in
                *" $_dl_id "*)
                    _dl_any=1
                    case "$_dl_pending" in
                        *" $_dl_id "*)
                            info "Loading dataset '$_dl_id' (EXAKIT_DATASETS)."
                            exakit_load_dataset "$_kit_root" "$_dl_id" || _dl_failed=1
                            ;;
                        *) ok "Dataset '$_dl_id' is already loaded — nothing to do (reload it with: exakit data-load --force)" ;;
                    esac
                    ;;
                *)
                    warn "Unknown dataset id '$_dl_id' in EXAKIT_DATASETS (available:$(printf '%s' "$_dl_known" | sed 's/ *$//'))."
                    ;;
            esac
        done
        [ "$_dl_any" -eq 1 ] || \
            die "EXAKIT_DATASETS='$EXAKIT_DATASETS' matched no bundled dataset — nothing was loaded."
        return "$_dl_failed"
    else
        command -v exakit_data_load_menu >/dev/null 2>&1 || \
            die "The exapump data-loading module is not available in this kit build."
        exakit_data_load_menu
    fi
}

cmd_mcp_setup() {
    # Options are refused, not ignored. `exakit mcp-setup --clients vscode_copilot`
    # ran the plain setup, said "already connected" and exited 0, so the agent
    # that typed it believed the client had been re-applied. Clients are named
    # through EXAKIT_MCP_CLIENTS, and the message says so. Exit 2 like every
    # other command's unknown option.
    for _cms_arg in "$@"; do
        case "$_cms_arg" in
            -*) reject "Unknown option '$_cms_arg' for mcp-setup (it takes none; name clients with EXAKIT_MCP_CLIENTS=claude,codex exakit mcp-setup)." ;;
            *)  reject "mcp-setup takes no arguments; name clients with EXAKIT_MCP_CLIENTS=$_cms_arg exakit mcp-setup" ;;
        esac
    done
    _require_install
    exakit_init_logging
    exakit_mcp_setup || die "Could not complete MCP client setup"
}

# cmd_mcp_doctor [--json] [clients] — diagnostics, with the DIAGNOSIS ORDER a
# diagnostician uses: is the database even running, before anything that needs
# it? Without that check the first downstream failure (creating the read-only
# user against a dead port) used to headline as "MCP user is broken" and send
# people at the MCP config — the wrong subsystem entirely. Exit 3 mirrors
# `exakit status`, so agents branch the same way on both.
#
# Doctor also REPAIRS what it finds. There is no separate repair command: being
# told a client is broken and then handed a second command to type is the tool
# asking the user to do the obvious next step by hand.
# cmd_mcp_remove <client...> — take the kit's managed entries out of the named
# clients and forget them. The remedy doctor prints for a client that is no
# longer on the machine ("remove the stale entry with 'exakit mcp-remove
# <client>'") named this command before it existed; the module has always had
# the operation. Clients only, by name; the server entries are the kit's.
cmd_mcp_remove() {
    [ "$#" -gt 0 ] || reject "Name the client(s) to remove the kit's MCP entries from: exakit mcp-remove cursor (see: exakit mcp-status)"
    for _cmr_arg in "$@"; do
        case "$_cmr_arg" in
            all) reject "mcp-remove takes client names, not 'all' — the full removal is: exakit uninstall" ;;
        esac
    done
    _require_install
    exakit_init_logging
    exakit_mcp_operation uninstall "$@" || die "Could not remove the MCP entries"
}

cmd_mcp_doctor() {
    # Parse BEFORE the install check: the check's own answer has to honour
    # --json, and it has to exit 4 rather than 1. Reversing these two lines is
    # what made `mcp-doctor --json` print nothing on a machine with no install.
    _cmd_json=0
    _cmd_rest=""
    for _cmd_arg in "$@"; do
        case "$_cmd_arg" in
            --json|-j) _cmd_json=1 ;;
            *) _cmd_rest="${_cmd_rest:+$_cmd_rest }$_cmd_arg" ;;
        esac
    done
    if [ ! -f "$EXAKIT_MANIFEST" ] || [ -z "$(_runtime_type)" ]; then
        _not_installed_answer "$_cmd_json"
    fi
    exakit_init_logging
    if ! exakit_runtime_is_running; then
        if [ "$_cmd_json" -eq 1 ]; then
            # Same three keys as every other --json answer from a state query
            # (installed / status / remedy), so one parser handles all of them.
            # `database` is kept for callers written against the older shape.
            printf '{"installed": true, "status": "database not running", "database": "not running", "remedy": "%s"}\n' \
                "$(exakit_runtime_remedy)"
        else
            warn "The database is not running — fix that first: $(exakit_runtime_remedy)"
            info "MCP diagnostics need a live database (the read-only user and its grants are checked against it)."
        fi
        exit 3
    fi
    if [ "$_cmd_json" -eq 1 ]; then
        EXAKIT_MCP_RESULT_JSON=1
        export EXAKIT_MCP_RESULT_JSON
    fi
    # shellcheck disable=SC2086 — client names are single tokens by contract
    exakit_mcp_operation doctor $_cmd_rest
    _cmd_rc=$?
    # A clean run, or one whose only findings are warnings repair cannot act
    # on, ends here. A run that exited 0 but reported a repairable WARNING - a
    # loosened file mode is the common one - goes on to the repair below: it
    # used to stop here, so doctor said "repairs drift", printed the warning,
    # and left the mode at 644.
    if [ "$_cmd_rc" = 0 ] && [ "${EXAKIT_MCP_LAST_REPAIRABLE:-0}" != 1 ]; then
        return 0
    fi
    # Anything other than "ran and reported" is the subsystem failing to run at
    # all, which is the only case that deserves the word "could not".
    [ "$_cmd_rc" = 0 ] || [ "$_cmd_rc" = 2 ] || die "Could not run MCP diagnostics"

    # The diagnosis found something. Repair it here rather than printing a
    # second command to type: someone runs mcp-doctor to be told their clients
    # are fine, and being handed `exakit mcp-repair` is the tool asking the user
    # to do the obvious next step by hand. mcp-setup ADDS clients; mcp-doctor
    # checks the ones already configured and puts them right.
    #
    # --json callers get the diagnosis unchanged: a machine parsing the report
    # must not have a second document appended to it.
    if [ "$_cmd_json" -eq 1 ]; then
        [ "$_cmd_rc" = 0 ] && exit 0
        exit 1
    fi
    # The repair runs QUIETLY. Its own summary panel repeats the client list and
    # the operation header the diagnosis above just printed, and in the common
    # case it has nothing to say beyond "no repair was needed" - three
    # near-identical reports for one question, where the reader is trying to
    # work out what actually happened. One line is the whole content.
    printf '\n'
    # shellcheck disable=SC2086 — client names are single tokens by contract
    _cmd_repair_out="$(exakit_mcp_operation repair $_cmd_rest 2>&1)"
    _cmd_repair_rc=$?
    if [ "$_cmd_repair_rc" != 0 ] && [ "$_cmd_repair_rc" != 2 ]; then
        printf '%s\n' "$_cmd_repair_out"
        die "Could not repair the managed MCP configuration"
    fi

    case "$_cmd_repair_out" in
        *no_change*|*"already consistent"*)
            # Nothing was rewritten, so a re-check would reprint the report
            # above word for word. Say what happened and stop.
            info "Nothing to repair: the managed client config is already consistent."
            warn "The findings above are not config drift, so they remain."
            exit 1
            ;;
    esac

    # Something WAS rewritten, so the report above is now out of date. Re-check
    # once - once only: a repair that did not take is a fault to report, not a
    # loop to run - and let that reading be the last word.
    info "Repaired the managed client config — re-checking"
    printf '\n'
    # shellcheck disable=SC2086 — client names are single tokens by contract
    exakit_mcp_operation doctor $_cmd_rest
    _cmd_rc=$?
    # A repair that took also retires the failure note the fault may have left:
    # `.last-failure` kept saying "Could not read managed MCP state" after the
    # config was put right, while status --json said null.
    [ "$_cmd_rc" = 0 ] && { exakit_clear_failure_note; ok "Everything the repair could fix is fixed."; return 0; }
    [ "$_cmd_rc" = 2 ] || die "Could not run MCP diagnostics"
    warn "Some findings are not config drift and remain — see the notes above."
    exit 1
}

cmd_mcp_status() {
    _require_install
    exakit_init_logging
    _ms_rest=""
    for _ms_arg in "$@"; do
        case "$_ms_arg" in
            # The JSON form existed behind an env var the doctor sets for
            # itself; here "--json" was read as a client name.
            --json|-j) EXAKIT_MCP_RESULT_JSON=1; export EXAKIT_MCP_RESULT_JSON ;;
            -*) reject "Unknown option '$_ms_arg' for mcp-status (supported: --json)." ;;
            *) _ms_rest="$_ms_rest $_ms_arg" ;;
        esac
    done
    # shellcheck disable=SC2086 — client names are single tokens by contract
    exakit_mcp_operation status $_ms_rest
    _cmd_rc=$?
    [ "$_cmd_rc" = 0 ] && return 0
    [ "$_cmd_rc" = 2 ] && exit 1
    die "Could not read managed MCP state"
}

